# ==============================================================
# ARCHNA ACADEMY - Environment Variables Configuration
# ==============================================================

# 1. SUPABASE_URL: URL of your Supabase project (e.g., https://hhgbinzhptehhtrgqpby.supabase.co)
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# 2. SUPABASE_PUBLISHABLE_KEY: Publishable/Anon API key for your Supabase project (client/public safe)
# Also supports alias SUPABASE_ANON_KEY or VITE_SUPABASE_PUBLISHABLE_KEY
SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY_HERE"

# 3. SUPABASE_SECRET_KEY: Server-side Secret / Service Role key for elevated database operations
# This is NEVER exposed to the frontend/browser code.
SUPABASE_SECRET_KEY="sb_secret_YOUR_KEY_HERE"

# 4. SUPABASE_JWKS_URL: Optional JWKS verification URL for Supabase Auth JWT tokens
SUPABASE_JWKS_URL="https://YOUR_PROJECT_ID.supabase.co/auth/v1/.well-known/jwks.json"

# 5. SESSION_SECRET: Secret key for signing admin and teacher JWT session tokens.
SESSION_SECRET="your_custom_secure_session_secret_key"

# 6. VITE_API_URL: Optional API base URL if frontend and backend are hosted on separate domains.
# Leave blank for standard same-origin Vercel deployment.
VITE_API_URL=""

# 7. PORT: Server listening port for local / standalone node execution (default: 3000)
PORT="3000"
