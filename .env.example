# ==============================================================
# ARCHNA ACADEMY - Environment Variables Configuration
# ==============================================================

# SUPABASE_URL: URL of your Supabase project (e.g., https://your-project.supabase.co)
# If omitted, defaults to the coaching institute's configured project: https://hhgbinzhptehhtrgqpby.supabase.co
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# SUPABASE_ANON_KEY: Publishable/Anon API key for your Supabase project
# Can also be set as SUPABASE_KEY or VITE_SUPABASE_ANON_KEY on Vercel
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# SESSION_SECRET: Secret key for signing admin and teacher JWT session tokens.
SESSION_SECRET="your_custom_secure_session_secret_key"

# VITE_API_URL: Optional API base URL if frontend and backend are hosted on separate domains.
# Leave blank or omit for standard same-origin Vercel deployment.
VITE_API_URL=""

# PORT: Server listening port for local / standalone node execution (default: 3000)
PORT="3000"
